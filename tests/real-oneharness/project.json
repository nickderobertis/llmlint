{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "real-oneharness",
  "//": "The real-oneharness tier: llmlint's forwarded --config layers resolved by the released oneharness. External (PyPI), so its suite is the network target, never a gate tier.",
  "projectType": "application",
  "tags": [
    "type:external",
    "coverage:shell"
  ],
  "implicitDependencies": [
    "llmlint",
    "llmlint-mock-oneharness"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt -p llmlint-real-oneharness -- --check",
          "bash tools/shell/shell.sh format tests/real-oneharness/*.sh"
        ],
        "parallel": false
      },
      "configurations": {
        "write": {
          "commands": [
            "cargo fmt -p llmlint-real-oneharness",
            "bash tools/shell/shell.sh format --write tests/real-oneharness/*.sh"
          ],
          "parallel": false
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p llmlint-real-oneharness --all-targets --locked -- -D warnings",
          "bash tools/shell/shell.sh lint tests/real-oneharness/*.sh"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "^default",
        "shellTools"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/coverage/shcov.sh run real-oneharness -- cargo nextest run -p llmlint-real-oneharness --locked"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/justfile",
        "shellCoverage"
      ],
      "//": "Offline: the_tier_pins_the_multi_file_floor, which holds the justfile's oneharness-cli-version pin to LAYERED_CONFIG_MIN_VERSION, and the installer's refusal of a malformed pin. The suite itself is the network target.",
      "outputs": [
        "{workspaceRoot}/target/shcov/real-oneharness.json"
      ]
    },
    "network": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "llmlint:build",
        "llmlint-mock-oneharness:build"
      ],
      "options": {
        "command": "bash tests/real-oneharness/network.sh"
      },
      "//": "The suite, outside the gate tiers: installs oneharness-cli from PyPI at the pin and runs the #[ignore]-d tests against it. `just test-oneharness` runs it."
    }
  }
}
