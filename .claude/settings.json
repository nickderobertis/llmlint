{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-setup.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just setup)",
      "Bash(just setup-check)",
      "Bash(./scripts/setup.sh)",
      "Bash(bash scripts/setup.sh)",
      "Bash(bash scripts/setup-check.sh)",
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just check --all)",
      "Bash(just coverage)",
      "Bash(just doc)",
      "Bash(just lint-workflows)",
      "Bash(just lint-sh)",
      "Bash(just actionlint-tools)",
      "Bash(just test)",
      "Bash(just test --all)",
      "Bash(just test-e2e)",
      "Bash(just test-release-targets)",
      "Bash(just test-oneharness)",
      "Bash(just lint)",
      "Bash(just lint --all)",
      "Bash(just lint-live)",
      "Bash(just live-claude)",
      "Bash(bash tests/live/live-claude.sh)",
      "Bash(just format)",
      "Bash(just fmt-check)",
      "Bash(just upgrade)",
      "Bash(just deps-check)",
      "Bash(just doctor)",
      "Bash(just msrv)",
      "Bash(just run:*)",
      "Bash(just bench)",
      "Bash(just bench-base)",
      "Bash(just bench-compare)",
      "Bash(just bench-cli)",
      "Bash(just bench-cli-smoke)",
      "Bash(just bench-allocs)",
      "Bash(just bench-instructions)",
      "Bash(just bench-all)",
      "Bash(just bench-tools)",
      "Bash(just profile:*)",
      "Bash(just screenshots)",
      "Bash(just screenshots-tools)",
      "Bash(just screenshots-bless)",
      "Bash(bash benches/bench.sh:*)",
      "Bash(bash benches/bench-instructions.sh:*)",
      "Bash(bash screenshots/screenshots.sh:*)",
      "Bash(bash benches/profile.sh:*)",
      "Bash(freeze:*)",
      "Bash(screencomp:*)",
      "Bash(cargo bench:*)",
      "Bash(critcmp:*)",
      "Bash(hyperfine:*)",
      "Bash(valgrind:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo run:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(bash scripts/nx:*)",
      "Bash(bun test:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo machete:*)",
      "Bash(cargo update:*)",
      "Bash(oneharness:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)"
    ],
    "deny": []
  }
}
