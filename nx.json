{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ],
    "shellTools": [
      "{workspaceRoot}/tools/shell/shell.sh",
      { "runtime": "bash tools/shell/shell.sh versions" }
    ],
    "shellCoverage": [
      "{workspaceRoot}/Gemfile",
      "{workspaceRoot}/Gemfile.lock",
      "{workspaceRoot}/.bundle/config",
      "{workspaceRoot}/tools/coverage/shcov.sh",
      "{workspaceRoot}/tools/coverage/shcov.rb",
      "{workspaceRoot}/tools/shell/shell.sh",
      { "env": "LLMLINT_COVERAGE" }
    ]
  },
  "targetDefaults": {
    "format": {
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "build": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "doc": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "inputs": ["default", "^default"]
    }
  }
}
