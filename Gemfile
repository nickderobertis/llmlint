# The shell coverage tool, pinned once for the repository: bashcov (and the
# SimpleCov it reports through), at the versions Gemfile.lock locks. `just
# bootstrap` installs them (tools/coverage/shcov.sh install) into .dev/bundle, the
# path .bundle/config names; tools/coverage/shcov.sh runs them. Ruby itself is the
# `.tool-versions` pin.
source "https://rubygems.org"

gem "bashcov", "4.0.0"
