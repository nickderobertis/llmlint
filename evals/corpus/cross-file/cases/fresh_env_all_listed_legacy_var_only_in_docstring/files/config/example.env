## Ingest pipeline — example environment.
## Required values have no default in code; everything else is optional.

# Required
WAREHOUSE_DSN=postgresql://ingest:secret@warehouse:5432/analytics
INGEST_S3_BUCKET=my-company-landing

# Optional (defaults shown)
INGEST_S3_PREFIX=raw/
AWS_REGION=us-east-1
INGEST_BATCH_ROWS=5000
INGEST_MAX_WORKERS=8
INGEST_SPOOL_DIR=/tmp/ingest
INGEST_DRY_RUN=0

# Optional: post a summary to Slack after each run. Leave empty to disable.
SLACK_WEBHOOK_URL=
